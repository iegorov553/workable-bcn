{
  "name": "barna-cafe-map",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.3",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.21",
    "expo-font": "~57.0.0",
    "expo-haptics": "~57.0.2",
    "expo-location": "~57.0.16",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "leaflet": "^1.9.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.20.2",
    "@types/react": "~19.2.2",
    "fast-xml-parser": "^5.10.0",
    "goldie": "^0.3.1",
    "opentype.js": "^2.0.0",
    "sharp": "^0.35.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "map:build": "node scripts/build-map.mjs --write",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "import-map": "node scripts/import-map.mjs",
    "test": "node --experimental-transform-types --test tests/*.test.ts",
    "test:discovery": "node --experimental-transform-types --test tests/discover-amb.test.ts",
    "check:places": "node scripts/check-places.mjs",
    "audit:places": "node scripts/audit-google-places.mjs",
    "audit:places:apply": "node scripts/audit-google-places.mjs --apply",
    "discover:amb": "node scripts/discover-amb-cafes.mjs",
    "discover:amb:apply": "node scripts/discover-amb-cafes.mjs --apply",
    "assets:build": "node scripts/build-brand-assets.mjs",
    "build:android": "npx eas-cli@latest build --platform android --profile production",
    "build:apk": "npx eas-cli@latest build --platform android --profile preview",
    "submit:android": "npx eas-cli@latest submit --platform android --profile production",
    "export:android": "expo export --platform android --output-dir dist/android",
    "goldie:frame": "goldie frame --config goldie/goldie.config.ts",
    "goldie:manifest": "goldie manifest --config goldie/goldie.config.ts",
    "goldie:studio": "goldie studio --config goldie/goldie.config.ts --no-open"
  },
  "private": true
}
